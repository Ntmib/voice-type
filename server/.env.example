# Ключ Deepgram (console.deepgram.com)
DEEPGRAM_API_KEY=change-me
# Токен авторизации клиентов: openssl rand -base64 32
VOICETYPE_TOKEN=change-me
# Постобработка пунктуации через OpenRouter (опционально, без ключа
# вернётся сырой текст Deepgram)
OPENROUTER_API_KEY=
# Прокси для OpenRouter, если сервер в регионе с блокировкой (опционально)
OPENROUTER_PROXY=
# Модель для расстановки пунктуации (опционально)
VOICETYPE_FORMAT_MODEL=anthropic/claude-haiku-4.5
# Модель распознавания Deepgram (опционально)
VOICETYPE_STT_MODEL=nova-3
