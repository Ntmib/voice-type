<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.voicetype.agent</string>
    <!-- Шаблон. install.sh подставляет реальный путь вместо __CLIENT_DIR__
         и кладёт готовый файл в ~/Library/LaunchAgents/.
         Токен живёт в .env рядом со скриптом (не в этом файле!).
         Python запускается НАПРЯМУЮ, без bash: разрешения macOS (Мониторинг
         ввода, Микрофон) привязываются к ответственному процессу службы —
         с bash-обёрткой ими владел бы bash, а не Python. -->
    <key>ProgramArguments</key>
    <array>
        <string>__CLIENT_DIR__/venv/bin/python3</string>
        <string>-u</string>
        <string>__CLIENT_DIR__/voice_type.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__CLIENT_DIR__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>StandardOutPath</key>
    <string>/tmp/voicetype.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/voicetype.log</string>
</dict>
</plist>
